{
  "manifest_version": 3,
  "name": "Instagram — fila local",
  "version": "1.21.0",
  "description": "Processa sua lista local usando a sessão da aba do Instagram.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "dashboard.html"
  }
}
